#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/cn@0.2.4/node_modules/cn/node_modules:/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/cn@0.2.4/node_modules:/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/cn@0.2.4/node_modules/cn/node_modules:/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/cn@0.2.4/node_modules:/home/shema/apps/personal/enterprise-auth/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../cn/bin/cn.mjs" "$@"
else
  exec node  "$basedir/../cn/bin/cn.mjs" "$@"
fi
